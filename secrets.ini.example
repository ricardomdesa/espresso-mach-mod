; Copie este arquivo para secrets.ini e troque o valor pelo código da sua
; máquina. secrets.ini está no .gitignore e nunca deve ser versionado: quem
; tem o código comanda a máquina (bomba, setpoint, extração).
;
;   cp secrets.ini.example secrets.ini
;
; Gere um código novo com:
;
;   openssl rand -hex 6
;
; Anote o código numa etiqueta na máquina — é ele que o app pede uma vez, no
; pareamento. Trocar o código exige regravar o firmware e parear o app de novo.
[secrets]
auth_key = 000000000000
